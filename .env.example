# 复制本文件为 .env 并填入你的 API 密钥（切勿将 .env 提交到 Git）
# Copy to .env and fill in your keys — never commit .env

# 云端对话模型（DeepSeek）— 方案 B 必填
DEEPSEEK_API_KEY=your-deepseek-api-key

# 向量嵌入（阿里云 DashScope，用于记忆检索）— 方案 B 必填
EMBEDDING_API_KEY=your-dashscope-api-key

# 可选：若单独配置通义千问，可取消下行注释；留空则使用 EMBEDDING_API_KEY
# QWEN_API_KEY=

# 可选：覆盖默认端口（与游戏「对局域网开放」一致）
# MINECRAFT_PORT=55916
# MINDSERVER_PORT=8080
